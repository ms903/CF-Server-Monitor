[Unit]
Description=CF Server Monitor source-to-server latency probe
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
Environment=CONFIG_FILE=%h/.config/cf-source-latency/config.conf
ExecStart=%h/.local/bin/cf-source-latency-probe.sh
Restart=always
RestartSec=10

[Install]
WantedBy=default.target
